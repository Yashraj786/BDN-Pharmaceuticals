<div class="flex items-center justify-between mb-6">
  <h1 class="text-3xl font-black text-gray-800">🚚 Suppliers</h1>
  <%= link_to "+ Add Supplier", new_supplier_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-3 rounded-lg text-xl" %>
</div>

<div class="bg-white rounded-2xl shadow overflow-hidden">
  <table class="w-full">
    <thead class="bg-gray-100">
      <tr>
        <th class="px-5 py-4 text-left text-lg font-bold">Supplier Name</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Phone</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Contact Person</th>
        <th class="px-5 py-4 text-left text-lg font-bold">City</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Delivery Days</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @suppliers.each_with_index do |s, i| %>
        <tr class="border-t <%= i.even? ? 'bg-white' : 'bg-gray-50' %> hover:bg-blue-50">
          <td class="px-5 py-4 text-lg font-semibold"><%= s.supplier_name %></td>
          <td class="px-5 py-4 text-lg">📞 <%= s.phone %></td>
          <td class="px-5 py-4 text-lg"><%= s.contact_person %></td>
          <td class="px-5 py-4 text-lg"><%= s.city %></td>
          <td class="px-5 py-4 text-lg"><%= s.delivery_days %> days</td>
          <td class="px-5 py-4">
            <div class="flex gap-2">
              <%= link_to "Edit", edit_supplier_path(s), class: "bg-blue-500 hover:bg-blue-600 text-white font-bold px-4 py-2 rounded-lg text-base" %>
              <%= button_to "Delete", supplier_path(s), method: :delete,
                  data: { confirm: "Delete #{s.supplier_name}?" },
                  class: "bg-red-500 hover:bg-red-600 text-white font-bold px-4 py-2 rounded-lg text-base" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @suppliers.empty? %>
    <div class="p-10 text-center text-xl text-gray-500">No suppliers yet.</div>
  <% end %>
</div>
