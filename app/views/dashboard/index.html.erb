<div class="mb-6 flex items-center justify-between">
  <h1 class="text-4xl font-black text-gray-800">📊 Daily Dashboard</h1>
  <div class="flex gap-3">
    <span class="text-xl text-gray-600"><%= Date.today.strftime("%A, %d %B %Y") %></span>
    <%= link_to "🔄 Refresh", dashboard_path, class: "bg-gray-600 hover:bg-gray-700 text-white text-lg font-bold px-5 py-2 rounded-lg" %>
  </div>
</div>

<!-- ALERT BAR -->
<% if @low_stock_count > 0 %>
  <div class="bg-red-100 border-l-4 border-red-600 text-red-800 p-4 rounded-lg mb-6 text-xl font-bold flex items-center gap-3">
    ⚠️ WARNING: <%= @low_stock_count %> raw material(s) are LOW on stock!
    <%= link_to "View Now →", raw_materials_path, class: "underline" %>
  </div>
<% end %>
<% if @quality_pending > 0 %>
  <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-800 p-4 rounded-lg mb-6 text-xl font-bold flex items-center gap-3">
    🔬 <%= @quality_pending %> batch(es) waiting for quality check!
    <%= link_to "Check Now →", quality_logs_path, class: "underline" %>
  </div>
<% end %>

<!-- BIG METRIC CARDS -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">

  <!-- Raw Materials -->
  <div class="bg-blue-50 border-4 border-blue-400 rounded-2xl p-6">
    <h2 class="text-xl font-bold text-blue-900 mb-2">🧪 Raw Materials</h2>
    <p class="text-6xl font-black text-blue-600 mb-1"><%= @total_materials %></p>
    <p class="text-lg text-gray-700">Total Items</p>
    <% if @low_stock_count > 0 %>
      <p class="text-lg text-red-600 font-bold mt-1">⚠️ <%= @low_stock_count %> LOW STOCK</p>
    <% else %>
      <p class="text-lg text-green-600 font-bold mt-1">✅ All OK</p>
    <% end %>
    <div class="mt-4 flex gap-2 flex-wrap">
      <%= link_to "View All", raw_materials_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
      <%= link_to "+ Add Stock", new_raw_material_path, class: "bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
    </div>
  </div>

  <!-- Production -->
  <div class="bg-yellow-50 border-4 border-yellow-400 rounded-2xl p-6">
    <h2 class="text-xl font-bold text-yellow-900 mb-2">🏭 Production</h2>
    <p class="text-6xl font-black text-yellow-600 mb-1"><%= @today_batches %></p>
    <p class="text-lg text-gray-700">Batches Today</p>
    <p class="text-lg text-blue-700 font-bold mt-1">📋 <%= @week_batches %> This Week</p>
    <p class="text-lg text-green-600 font-bold">✅ <%= @ready_batches %> Ready to Sell</p>
    <div class="mt-4 flex gap-2 flex-wrap">
      <%= link_to "View All", production_batches_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
      <%= link_to "+ New Batch", new_production_batch_path, class: "bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
    </div>
  </div>

  <!-- Inventory -->
  <div class="bg-purple-50 border-4 border-purple-400 rounded-2xl p-6">
    <h2 class="text-xl font-bold text-purple-900 mb-2">📦 Inventory</h2>
    <p class="text-6xl font-black text-purple-600 mb-1"><%= @total_inventory_liters.to_i %></p>
    <p class="text-lg text-gray-700">Liters Ready to Sell</p>
    <p class="text-lg text-gray-500 mt-1">Finished goods in stock</p>
    <div class="mt-4 flex gap-2 flex-wrap">
      <%= link_to "View Stock", inventory_index_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
    </div>
  </div>

  <!-- Sales Today -->
  <div class="bg-green-50 border-4 border-green-400 rounded-2xl p-6">
    <h2 class="text-xl font-bold text-green-900 mb-2">🛒 Sales Today</h2>
    <p class="text-6xl font-black text-green-600 mb-1"><%= @today_sales %></p>
    <p class="text-lg text-gray-700">Orders Completed</p>
    <p class="text-lg text-blue-700 font-bold mt-1">₹<%= number_with_delimiter(@today_revenue) %> Earned</p>
    <div class="mt-4 flex gap-2 flex-wrap">
      <%= link_to "View Sales", sales_orders_path(filter: "today"), class: "bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
      <%= link_to "+ New Sale", new_sales_order_path, class: "bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
    </div>
  </div>

  <!-- Outstanding Money -->
  <div class="bg-red-50 border-4 border-red-400 rounded-2xl p-6">
    <h2 class="text-xl font-bold text-red-900 mb-2">💰 Outstanding Money</h2>
    <p class="text-6xl font-black text-red-600 mb-1">₹<%= number_with_delimiter(@outstanding) %></p>
    <p class="text-lg text-gray-700">Customers Owe Us</p>
    <p class="text-lg text-gray-500 mt-1">Pending payments</p>
    <div class="mt-4 flex gap-2 flex-wrap">
      <%= link_to "Collect Payment", sales_orders_path, class: "bg-red-600 hover:bg-red-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
    </div>
  </div>

  <!-- This Month Finance -->
  <div class="bg-indigo-50 border-4 border-indigo-400 rounded-2xl p-6">
    <h2 class="text-xl font-bold text-indigo-900 mb-2">📈 This Month</h2>
    <p class="text-5xl font-black <%= @net_profit >= 0 ? 'text-green-600' : 'text-red-600' %> mb-1">
      ₹<%= number_with_delimiter(@net_profit) %>
    </p>
    <p class="text-lg text-gray-700">Net Profit</p>
    <p class="text-lg text-green-700 font-bold mt-1">↑ ₹<%= number_with_delimiter(@month_revenue) %> Revenue</p>
    <p class="text-lg text-red-700 font-bold">↓ ₹<%= number_with_delimiter(@month_expenses) %> Expenses</p>
    <div class="mt-4">
      <%= link_to "Full Report", reports_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
    </div>
  </div>

  <!-- Quality Checks -->
  <div class="bg-teal-50 border-4 border-teal-400 rounded-2xl p-6">
    <h2 class="text-xl font-bold text-teal-900 mb-2">🔬 Quality Checks</h2>
    <p class="text-6xl font-black text-teal-600 mb-1"><%= @quality_pending %></p>
    <p class="text-lg text-gray-700">Pending Checks</p>
    <p class="text-lg text-green-600 font-bold mt-1">✅ <%= @quality_done %> Done This Month</p>
    <div class="mt-4">
      <%= link_to "Check Now", quality_logs_path, class: "bg-teal-600 hover:bg-teal-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="bg-gray-50 border-4 border-gray-300 rounded-2xl p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">⚡ Quick Actions</h2>
    <div class="space-y-3">
      <%= link_to "+ Start New Batch", new_production_batch_path,
          class: "block bg-yellow-500 hover:bg-yellow-600 text-white font-bold px-4 py-3 rounded-lg text-lg text-center" %>
      <%= link_to "+ New Sale", new_sales_order_path,
          class: "block bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-3 rounded-lg text-lg text-center" %>
      <%= link_to "+ Add Expense", new_expense_path,
          class: "block bg-red-600 hover:bg-red-700 text-white font-bold px-4 py-3 rounded-lg text-lg text-center" %>
    </div>
  </div>
</div>

<!-- LOW STOCK TABLE -->
<% if @low_materials.any? %>
  <div class="bg-white rounded-2xl shadow p-6">
    <h2 class="text-2xl font-bold text-red-700 mb-4">⚠️ Low Stock Alert — Action Required</h2>
    <table class="w-full">
      <thead class="bg-red-50">
        <tr>
          <th class="px-4 py-3 text-left text-lg font-bold text-red-800">Material</th>
          <th class="px-4 py-3 text-left text-lg font-bold text-red-800">Current Stock</th>
          <th class="px-4 py-3 text-left text-lg font-bold text-red-800">Min. Required</th>
          <th class="px-4 py-3 text-left text-lg font-bold text-red-800">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @low_materials.each do |m| %>
          <tr class="border-t border-red-100 hover:bg-red-50">
            <td class="px-4 py-3 text-lg font-semibold"><%= m.material_name %></td>
            <td class="px-4 py-3 text-lg text-red-700 font-bold"><%= m.current_stock_quantity %> <%= m.unit_of_measurement %></td>
            <td class="px-4 py-3 text-lg"><%= m.reorder_level %> <%= m.unit_of_measurement %></td>
            <td class="px-4 py-3">
              <%= link_to "Add Stock Now", add_stock_raw_material_path(m), method: :get,
                  class: "bg-red-600 hover:bg-red-700 text-white font-bold px-4 py-2 rounded-lg" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
