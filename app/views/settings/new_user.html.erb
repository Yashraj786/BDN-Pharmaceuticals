<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-black mb-6">👤 Add New User</h1>
  <%= form_with model: @user, url: create_user_setting_path, local: true, class: "space-y-5" do |f| %>
    <div><%= f.label :name, "Full Name", class: "block text-xl font-semibold mb-2" %>
      <%= f.text_field :name, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
    <div><%= f.label :email, "Email Address", class: "block text-xl font-semibold mb-2" %>
      <%= f.email_field :email, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
    <div><%= f.label :phone, "Phone Number", class: "block text-xl font-semibold mb-2" %>
      <%= f.text_field :phone, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
    <div><%= f.label :role, "Role", class: "block text-xl font-semibold mb-2" %>
      <%= f.select :role, User::ROLES.map { |r| [r.humanize, r] },
          { prompt: "Select role" },
          class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none bg-white" %></div>
    <div><%= f.label :password, "Password (min 4 characters)", class: "block text-xl font-semibold mb-2" %>
      <%= f.password_field :password, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
    <div class="flex gap-4 pt-4">
      <%= f.submit "CREATE USER", class: "flex-1 bg-blue-600 hover:bg-blue-700 text-white text-2xl font-bold py-4 rounded-xl cursor-pointer" %>
      <%= link_to "CANCEL", settings_path, class: "flex-1 bg-gray-400 hover:bg-gray-500 text-white text-2xl font-bold py-4 rounded-xl text-center" %>
    </div>
  <% end %>
</div>
