<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-black mb-6">✏️ Edit Inventory: <%= @item.product_name %></h1>

  <%= form_with model: @item, url: inventory_path(@item), method: :patch, local: true, class: "space-y-5" do |f| %>
    <div>
      <%= f.label :product_name, "Product Name", class: "block text-xl font-semibold mb-2" %>
      <%= f.text_field :product_name, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :quantity_liters, "Quantity (Liters)", class: "block text-xl font-semibold mb-2" %>
      <%= f.number_field :quantity_liters, step: "0.01", class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :storage_location, "Storage Location", class: "block text-xl font-semibold mb-2" %>
      <%= f.text_field :storage_location, placeholder: "e.g., Warehouse A, Tank 3", class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :cost_per_liter, "Cost Per Liter (₹)", class: "block text-xl font-semibold mb-2" %>
      <%= f.number_field :cost_per_liter, step: "0.01", class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :sale_price_per_liter, "Sale Price Per Liter (₹)", class: "block text-xl font-semibold mb-2" %>
      <%= f.number_field :sale_price_per_liter, step: "0.01", class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
    </div>
    <div class="flex gap-4 pt-4">
      <%= f.submit "SAVE CHANGES", class: "flex-1 bg-blue-600 hover:bg-blue-700 text-white text-2xl font-bold py-4 rounded-xl cursor-pointer" %>
      <%= link_to "CANCEL", inventory_index_path, class: "flex-1 bg-gray-400 hover:bg-gray-500 text-white text-2xl font-bold py-4 rounded-xl text-center" %>
    </div>
  <% end %>

  <!-- MANUAL ADJUSTMENT -->
  <div class="bg-orange-50 border-2 border-orange-300 rounded-2xl p-6 mt-6">
    <h2 class="text-2xl font-bold text-orange-800 mb-4">🔧 Manual Stock Adjustment</h2>
    <p class="text-lg text-gray-600 mb-4">Use positive number to add stock, negative to remove.</p>
    <%= form_with url: adjust_inventory_path(@item), method: :post, local: true do |f| %>
      <div class="flex gap-4 items-end">
        <div class="flex-1">
          <label class="block text-xl font-semibold mb-2">Adjustment Amount</label>
          <%= f.number_field :adjustment, placeholder: "+50 or -20", step: "0.01",
              class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
        </div>
        <%= f.submit "ADJUST STOCK", class: "bg-orange-600 hover:bg-orange-700 text-white text-xl font-bold px-6 py-4 rounded-xl cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
