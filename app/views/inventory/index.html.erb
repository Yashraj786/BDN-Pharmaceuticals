<div class="flex items-center justify-between mb-6">
  <h1 class="text-3xl font-black">📦 Inventory — Finished Products</h1>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
  <% @items.each do |item| %>
    <% colors = { "good" => ["bg-green-50", "border-green-400", "text-green-700"],
                  "medium" => ["bg-yellow-50", "border-yellow-400", "text-yellow-700"],
                  "low" => ["bg-red-50", "border-red-400", "text-red-700"] }
       c = colors[item.stock_status] %>
    <div class="<%= c[0] %> border-4 <%= c[1] %> rounded-2xl p-6">
      <h2 class="text-2xl font-black text-gray-800 mb-1"><%= item.product_name %></h2>
      <p class="text-5xl font-black <%= c[2] %> mb-1"><%= item.quantity_liters.to_f.round(0) %> L</p>
      <p class="text-lg text-gray-700 mb-2">
        <%= item.stock_status == "good" ? "✅ Good Stock" : item.stock_status == "medium" ? "⚠️ Medium Stock" : "🔴 Low Stock" %>
      </p>
      <div class="space-y-1 text-lg text-gray-700 mb-4">
        <p>Cost/Liter: <strong>₹<%= item.cost_per_liter.to_f.round(2) %></strong></p>
        <p>Sale/Liter: <strong>₹<%= item.sale_price_per_liter.to_f.round(2) %></strong></p>
        <p>Profit Margin: <strong class="text-green-700"><%= item.profit_margin_percent %>%</strong></p>
        <% if item.storage_location.present? %>
          <p>Location: <strong><%= item.storage_location %></strong></p>
        <% end %>
      </div>
      <div class="flex gap-3 flex-wrap">
        <%= link_to "Details / Edit", edit_inventory_path(item),
            class: "bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
        <%= link_to "Sell Now →", new_sales_order_path(product_name: item.product_name),
            class: "bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
      </div>
    </div>
  <% end %>
</div>

<% if @items.empty? %>
  <div class="bg-white rounded-2xl shadow p-10 text-center text-xl text-gray-500">
    No inventory yet. Complete a production batch and mark it "Ready for Sale" to add products here.
  </div>
<% end %>
