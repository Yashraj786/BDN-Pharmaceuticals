<div class="bg-white rounded-2xl shadow-2xl p-10 w-full max-w-md">
  <div class="text-center mb-8">
    <div class="text-6xl mb-4">🏭</div>
    <h1 class="text-4xl font-black text-blue-800">BDN Factory</h1>
    <p class="text-xl text-gray-600 mt-2">Please log in to continue</p>
  </div>

  <%= form_with url: login_path, method: :post, local: true do |f| %>
    <div class="mb-6">
      <label class="block text-2xl font-semibold text-gray-800 mb-3">Email Address</label>
      <%= f.email_field :email, placeholder: "your@email.com",
          class: "w-full text-2xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none",
          required: true %>
    </div>

    <div class="mb-8">
      <label class="block text-2xl font-semibold text-gray-800 mb-3">Password</label>
      <%= f.password_field :password, placeholder: "Enter password",
          class: "w-full text-2xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none",
          required: true %>
    </div>

    <%= f.submit "LOG IN →",
        class: "w-full bg-blue-600 hover:bg-blue-700 text-white text-2xl font-bold py-4 rounded-xl cursor-pointer transition-colors" %>
  <% end %>

  <div class="mt-6 text-center text-gray-500 text-lg">
    Default login: <strong>admin@bdn.com</strong> / <strong>admin</strong>
  </div>
</div>
