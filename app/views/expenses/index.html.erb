<div class="flex items-center justify-between mb-6">
  <h1 class="text-3xl font-black">💸 Expenses</h1>
  <%= link_to "+ Add Expense", new_expense_path, class: "bg-red-600 hover:bg-red-700 text-white font-bold px-5 py-3 rounded-lg text-xl" %>
</div>

<div class="bg-red-50 border-2 border-red-300 rounded-2xl p-5 mb-6">
  <p class="text-2xl font-bold text-red-800">Total Expenses This Month: ₹<%= number_with_delimiter(@total_this_month.to_f.round(0)) %></p>
</div>

<div class="bg-white rounded-2xl shadow overflow-hidden">
  <table class="w-full">
    <thead class="bg-gray-100">
      <tr>
        <th class="px-5 py-4 text-left text-lg font-bold">Date</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Type</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Amount</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Description</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Payment</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @expenses.each_with_index do |e, i| %>
        <tr class="border-t <%= i.even? ? 'bg-white' : 'bg-gray-50' %> hover:bg-red-50">
          <td class="px-5 py-4 text-lg"><%= e.expense_date&.strftime("%d %b %Y") %></td>
          <td class="px-5 py-4 text-lg font-semibold"><%= e.type_label %></td>
          <td class="px-5 py-4 text-lg font-bold text-red-700">₹<%= number_with_delimiter(e.amount.to_f.round(0)) %></td>
          <td class="px-5 py-4 text-lg"><%= e.description.to_s.truncate(50) %></td>
          <td class="px-5 py-4 text-lg"><%= e.payment_method&.humanize %></td>
          <td class="px-5 py-4">
            <div class="flex gap-2">
              <%= link_to "Edit", edit_expense_path(e), class: "bg-blue-500 hover:bg-blue-600 text-white font-bold px-4 py-2 rounded-lg text-base" %>
              <%= button_to "Delete", expense_path(e), method: :delete,
                  data: { confirm: "Delete this expense?" },
                  class: "bg-red-500 hover:bg-red-600 text-white font-bold px-4 py-2 rounded-lg text-base" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @expenses.empty? %>
    <div class="p-10 text-center text-xl text-gray-500">No expenses recorded yet.</div>
  <% end %>
</div>
