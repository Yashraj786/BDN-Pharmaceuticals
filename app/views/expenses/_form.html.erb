<%= form_with model: expense, local: true, class: "space-y-5" do |f| %>
  <div><%= f.label :expense_date, "Date", class: "block text-xl font-semibold mb-2" %>
    <%= f.date_field :expense_date, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
  <div><%= f.label :expense_type, "Expense Type", class: "block text-xl font-semibold mb-2" %>
    <%= f.select :expense_type, Expense::TYPES.map { |t| [t.humanize, t] },
        { prompt: "Select type" },
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none bg-white" %></div>
  <div><%= f.label :amount, "Amount (₹)", class: "block text-xl font-semibold mb-2" %>
    <%= f.number_field :amount, placeholder: "0.00", step: "0.01", min: 0.01,
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
  <div><%= f.label :description, "Description", class: "block text-xl font-semibold mb-2" %>
    <%= f.text_area :description, rows: 2, placeholder: "Details about this expense",
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
  <div><%= f.label :payment_method, "Payment Method", class: "block text-xl font-semibold mb-2" %>
    <%= f.select :payment_method, [["Cash", "cash"], ["Cheque", "check"], ["Bank Transfer", "bank"]],
        { prompt: "Select method" },
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none bg-white" %></div>
  <div class="flex gap-4 pt-4">
    <%= f.submit expense.new_record? ? "SAVE EXPENSE" : "UPDATE EXPENSE",
        class: "flex-1 bg-red-600 hover:bg-red-700 text-white text-2xl font-bold py-4 rounded-xl cursor-pointer" %>
    <%= link_to "CANCEL", expenses_path, class: "flex-1 bg-gray-400 hover:bg-gray-500 text-white text-2xl font-bold py-4 rounded-xl text-center" %>
  </div>
<% end %>
