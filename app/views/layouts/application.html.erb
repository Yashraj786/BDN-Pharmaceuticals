<!DOCTYPE html>
<html lang="en">
  <head>
    <title>BDN Factory Manager</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900 text-lg">

    <% if logged_in? %>
      <header class="bg-blue-800 text-white px-6 py-4 flex items-center justify-between shadow-lg fixed top-0 left-0 right-0 z-50">
        <span class="text-2xl font-black tracking-wide">🏭 BDN Pharmaceuticals</span>
        <div class="flex items-center gap-4 text-base">
          <span class="hidden md:block"><%= Time.now.strftime("%d %b %Y") %></span>
          <span class="font-semibold">👤 <%= current_user.name %></span>
          <%= button_to "Logout", logout_path, method: :delete,
              class: "bg-red-600 hover:bg-red-700 text-white font-bold px-4 py-2 rounded-lg" %>
        </div>
      </header>

      <div class="flex pt-16 min-h-screen">
        <nav class="w-56 bg-white shadow-lg flex-shrink-0 fixed top-16 bottom-0 overflow-y-auto z-40">
          <ul class="py-3 space-y-1">
            <%= nav_item "🏠 Dashboard",     dashboard_path %>
            <%= nav_item "🧪 Raw Materials",  raw_materials_path %>
            <%= nav_item "🏭 Production",     production_batches_path %>
            <%= nav_item "✅ Quality Check",  quality_logs_path %>
            <%= nav_item "📦 Inventory",      inventory_index_path %>
            <%= nav_item "🛒 Sales",          sales_orders_path %>
            <%= nav_item "👥 Customers",      customers_path %>
            <%= nav_item "💸 Expenses",       expenses_path %>
            <%= nav_item "📊 Reports",        reports_path %>
            <% if current_user&.admin? %>
              <%= nav_item "⚙️ Settings",     settings_path %>
            <% end %>
          </ul>
          <div class="px-4 py-4 border-t mt-2">
            <p class="text-sm text-gray-500">Need help?</p>
            <p class="text-lg font-bold text-blue-700">+91 98765 43210</p>
          </div>
        </nav>

        <main class="ml-56 flex-1 p-6">
          <% if flash[:notice] %>
            <div class="bg-green-100 border-l-4 border-green-600 text-green-800 p-4 rounded-lg mb-5 text-lg font-semibold">
              ✅ <%= flash[:notice] %>
            </div>
          <% end %>
          <% if flash[:alert] %>
            <div class="bg-red-100 border-l-4 border-red-600 text-red-800 p-4 rounded-lg mb-5 text-lg font-semibold">
              ⚠️ <%= flash[:alert] %>
            </div>
          <% end %>
          <%= yield %>
        </main>
      </div>

    <% else %>
      <main class="min-h-screen bg-blue-50 flex items-center justify-center">
        <%= yield %>
      </main>
    <% end %>

  </body>
</html>
