<div class="flex items-center justify-between mb-6">
  <h1 class="text-3xl font-black">💰 Customer Credit Report</h1>
  <button onclick="window.print()" class="bg-blue-600 text-white font-bold px-6 py-3 rounded-lg text-lg">🖨️ Print</button>
</div>

<% total_outstanding = @orders_owing.sum { |o| o.outstanding_amount } %>
<div class="bg-red-50 border-2 border-red-400 rounded-xl p-5 mb-6">
  <p class="text-2xl font-bold text-red-800">Total Outstanding: ₹<%= number_with_delimiter(total_outstanding.to_f.round(0)) %></p>
</div>

<div class="bg-white rounded-2xl shadow overflow-hidden mb-6">
  <table class="w-full">
    <thead class="bg-gray-100">
      <tr>
        <th class="px-5 py-4 text-left text-lg font-bold">Customer</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Phone</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Order Date</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Product</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Total</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Paid</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Outstanding</th>
      </tr>
    </thead>
    <tbody>
      <% @orders_owing.each_with_index do |o, i| %>
        <tr class="border-t <%= i.even? ? 'bg-white' : 'bg-red-50' %>">
          <td class="px-5 py-4 text-lg font-bold"><%= o.customer_name %></td>
          <td class="px-5 py-4 text-lg"><%= o.phone %></td>
          <td class="px-5 py-4 text-lg"><%= o.order_date&.strftime("%d %b %Y") %></td>
          <td class="px-5 py-4 text-lg"><%= o.product_name %></td>
          <td class="px-5 py-4 text-lg font-bold">₹<%= number_with_delimiter(o.total_amount.to_f.round(0)) %></td>
          <td class="px-5 py-4 text-lg text-green-700">₹<%= number_with_delimiter(o.amount_paid.to_f.round(0)) %></td>
          <td class="px-5 py-4 text-lg font-black text-red-700">₹<%= number_with_delimiter(o.outstanding_amount.to_f.round(0)) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @orders_owing.empty? %>
    <div class="p-10 text-center text-xl text-green-600 font-bold">✅ No outstanding payments! All customers are up to date.</div>
  <% end %>
</div>
<%= link_to "← Back to Reports", reports_path, class: "bg-gray-500 text-white font-bold px-6 py-3 rounded-lg text-lg" %>
