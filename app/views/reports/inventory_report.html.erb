<div class="flex items-center justify-between mb-6">
  <h1 class="text-3xl font-black">📦 Inventory Report</h1>
  <button onclick="window.print()" class="bg-blue-600 text-white font-bold px-6 py-3 rounded-lg text-lg">🖨️ Print</button>
</div>

<div class="bg-blue-50 border-2 border-blue-400 rounded-xl p-5 mb-6">
  <p class="text-2xl font-bold">Total Inventory Value: <span class="text-blue-700">₹<%= number_with_delimiter(@total_value.to_f.round(0)) %></span></p>
</div>

<div class="bg-white rounded-2xl shadow overflow-hidden mb-6">
  <table class="w-full">
    <thead class="bg-gray-100">
      <tr>
        <th class="px-5 py-4 text-left text-lg font-bold">Product</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Quantity</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Storage</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Cost/L</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Sale/L</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Margin</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Total Value</th>
        <th class="px-5 py-4 text-left text-lg font-bold">Status</th>
      </tr>
    </thead>
    <tbody>
      <% @items.each_with_index do |item, i| %>
        <tr class="border-t <%= i.even? ? 'bg-white' : 'bg-gray-50' %>">
          <td class="px-5 py-4 text-lg font-bold"><%= item.product_name %></td>
          <td class="px-5 py-4 text-lg"><%= item.quantity_liters.to_f.round(0) %> L</td>
          <td class="px-5 py-4 text-lg"><%= item.storage_location.presence || "—" %></td>
          <td class="px-5 py-4 text-lg">₹<%= item.cost_per_liter.to_f.round(2) %></td>
          <td class="px-5 py-4 text-lg">₹<%= item.sale_price_per_liter.to_f.round(2) %></td>
          <td class="px-5 py-4 text-lg font-bold text-green-700"><%= item.profit_margin_percent %>%</td>
          <td class="px-5 py-4 text-lg font-bold">₹<%= number_with_delimiter(((item.quantity_liters || 0) * (item.cost_per_liter || 0)).round(0)) %></td>
          <td class="px-5 py-4">
            <% c = {"good"=>"bg-green-100 text-green-800","medium"=>"bg-yellow-100 text-yellow-800","low"=>"bg-red-100 text-red-800"} %>
            <span class="<%= c[item.stock_status] %> px-3 py-1 rounded-full font-bold text-base">
              <%= item.stock_status.capitalize %>
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= link_to "← Back to Reports", reports_path, class: "bg-gray-500 text-white font-bold px-6 py-3 rounded-lg text-lg" %>
