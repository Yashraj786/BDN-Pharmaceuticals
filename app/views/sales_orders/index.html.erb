<div class="flex items-center justify-between mb-6">
  <h1 class="text-3xl font-black">🛒 Sales Orders</h1>
  <%= link_to "+ New Sale", new_sales_order_path, class: "bg-green-600 hover:bg-green-700 text-white font-bold px-5 py-3 rounded-lg text-xl" %>
</div>

<!-- FILTER TABS -->
<div class="flex gap-3 mb-6 flex-wrap">
  <% [["All", "all"], ["Today", "today"], ["This Week", "week"], ["This Month", "month"]].each do |label, val| %>
    <%= link_to label, sales_orders_path(filter: val == "all" ? nil : val),
        class: "px-5 py-2 rounded-lg font-bold text-lg #{@filter == val || (@filter.blank? && val == 'all') ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 border-2'}" %>
  <% end %>
</div>

<div class="bg-white rounded-2xl shadow overflow-hidden">
  <table class="w-full">
    <thead class="bg-gray-100">
      <tr>
        <th class="px-4 py-4 text-left text-lg font-bold">#</th>
        <th class="px-4 py-4 text-left text-lg font-bold">Customer</th>
        <th class="px-4 py-4 text-left text-lg font-bold">Product</th>
        <th class="px-4 py-4 text-left text-lg font-bold">Qty</th>
        <th class="px-4 py-4 text-left text-lg font-bold">Total</th>
        <th class="px-4 py-4 text-left text-lg font-bold">Paid</th>
        <th class="px-4 py-4 text-left text-lg font-bold">Outstanding</th>
        <th class="px-4 py-4 text-left text-lg font-bold">Payment</th>
        <th class="px-4 py-4 text-left text-lg font-bold">Delivery</th>
        <th class="px-4 py-4 text-left text-lg font-bold">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each_with_index do |o, i| %>
        <tr class="border-t <%= i.even? ? 'bg-white' : 'bg-gray-50' %> hover:bg-blue-50">
          <td class="px-4 py-4 text-lg">#<%= o.id %></td>
          <td class="px-4 py-4 text-lg font-semibold"><%= o.customer_name %></td>
          <td class="px-4 py-4 text-lg"><%= o.product_name %></td>
          <td class="px-4 py-4 text-lg"><%= o.quantity_ordered_liters.to_f.round(0) %> L</td>
          <td class="px-4 py-4 text-lg font-bold">₹<%= number_with_delimiter(o.total_amount.to_f.round(0)) %></td>
          <td class="px-4 py-4 text-lg text-green-700 font-bold">₹<%= number_with_delimiter(o.amount_paid.to_f.round(0)) %></td>
          <td class="px-4 py-4 text-lg <%= o.outstanding_amount > 0 ? 'text-red-700 font-bold' : 'text-gray-400' %>">
            ₹<%= number_with_delimiter(o.outstanding_amount.to_f.round(0)) %>
          </td>
          <td class="px-4 py-4"><%= status_badge(o.payment_status) %></td>
          <td class="px-4 py-4"><%= status_badge(o.delivery_status) %></td>
          <td class="px-4 py-4">
            <div class="flex gap-2 flex-wrap">
              <% if o.payment_status != "paid" %>
                <%= link_to "💰 Collect", "#collect-#{o.id}",
                    class: "bg-green-600 hover:bg-green-700 text-white font-bold px-3 py-2 rounded-lg text-sm",
                    data: { toggle: "payment-form-#{o.id}" },
                    onclick: "document.getElementById('payment-form-#{o.id}').classList.toggle('hidden'); return false;" %>
              <% end %>
              <% if o.delivery_status == "pending" %>
                <%= button_to "🚚 Delivered", mark_delivered_sales_order_path(o), method: :patch,
                    class: "bg-blue-600 hover:bg-blue-700 text-white font-bold px-3 py-2 rounded-lg text-sm" %>
              <% end %>
            </div>
            <!-- INLINE PAYMENT FORM -->
            <% if o.payment_status != "paid" %>
              <div id="payment-form-<%= o.id %>" class="hidden mt-3 bg-green-50 border-2 border-green-300 rounded-xl p-4">
                <%= form_with url: collect_payment_sales_order_path(o), method: :post, local: true do |f| %>
                  <p class="text-base font-bold text-red-700 mb-2">Outstanding: ₹<%= number_with_delimiter(o.outstanding_amount.to_f.round(0)) %></p>
                  <div class="flex gap-2 items-center mb-2">
                    <%= f.number_field :amount_received, placeholder: "Amount", step: "0.01", min: 0.01,
                        class: "w-32 text-lg p-2 border-2 border-gray-300 rounded-lg focus:border-blue-500 focus:outline-none" %>
                    <%= f.select :payment_method, [["Cash", "cash"], ["Cheque", "check"], ["Bank", "bank"]],
                        {},
                        class: "text-base p-2 border-2 border-gray-300 rounded-lg bg-white" %>
                    <%= f.submit "SAVE", class: "bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-2 rounded-lg text-base cursor-pointer" %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @orders.empty? %>
    <div class="p-10 text-center text-xl text-gray-500">No sales orders found.</div>
  <% end %>
</div>
