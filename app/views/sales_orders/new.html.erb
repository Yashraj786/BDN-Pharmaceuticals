<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-black mb-6">🛒 Create New Sale</h1>

  <%= form_with model: @order, local: true, class: "space-y-6" do |f| %>
    <% if @order.errors.any? %>
      <div class="bg-red-100 border-l-4 border-red-600 p-4 rounded-lg">
        <% @order.errors.full_messages.each do |msg| %>
          <p class="text-lg text-red-700">• <%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <!-- Customer -->
    <div>
      <label class="block text-xl font-semibold mb-2">Customer Name</label>
      <% if @customers.any? %>
        <p class="text-base text-gray-500 mb-2">Select existing customer or type a new name below</p>
        <%= f.select :customer_id, @customers.map { |c| [c.customer_name, c.id] },
            { prompt: "— Select Existing Customer —" },
            class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none bg-white mb-2" %>
        <p class="text-base text-gray-500 mb-2 text-center">— OR type a new name —</p>
      <% end %>
      <%= f.text_field :customer_name, placeholder: "Customer full name",
          class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
    </div>

    <div>
      <label class="block text-xl font-semibold mb-2">Phone Number</label>
      <%= f.text_field :phone, placeholder: "+91 XXXXX XXXXX",
          class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
    </div>

    <div>
      <label class="block text-xl font-semibold mb-2">Address</label>
      <%= f.text_area :address, rows: 2, placeholder: "Delivery address",
          class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
    </div>

    <div>
      <label class="block text-xl font-semibold mb-2">Product</label>
      <%= f.select :product_name,
          @products.map { |name, price| ["#{name} (₹#{price}/L)", name] },
          { prompt: "Select product", selected: params[:product_name] },
          class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none bg-white",
          id: "product_select" %>
    </div>

    <div>
      <label class="block text-xl font-semibold mb-2">Quantity (Liters)</label>
      <%= f.number_field :quantity_ordered_liters, placeholder: "0", step: "0.01", min: 0,
          class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none",
          id: "qty_field" %>
    </div>

    <div>
      <label class="block text-xl font-semibold mb-2">Unit Price Per Liter (₹)</label>
      <%= f.number_field :unit_price, placeholder: "0.00", step: "0.01", min: 0,
          class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none",
          id: "price_field" %>
      <p class="text-base text-gray-500 mt-1">Price is auto-filled from inventory. You can change it.</p>
    </div>

    <!-- AUTO-CALCULATED TOTAL -->
    <div class="bg-blue-50 border-4 border-blue-400 rounded-2xl p-6">
      <p class="text-2xl font-bold text-blue-900 mb-2">💰 Total Amount</p>
      <p class="text-5xl font-black text-blue-700" id="total_display">₹0</p>
      <p class="text-lg text-gray-600 mt-2">= Quantity × Unit Price (calculated automatically)</p>
    </div>

    <div>
      <label class="block text-xl font-semibold mb-2">Order Date</label>
      <%= f.date_field :order_date, value: Date.today,
          class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
    </div>

    <div class="flex gap-4 pt-4">
      <%= f.submit "COMPLETE SALE →",
          class: "flex-1 bg-green-600 hover:bg-green-700 text-white text-2xl font-bold py-4 rounded-xl cursor-pointer" %>
      <%= link_to "CANCEL", sales_orders_path,
          class: "flex-1 bg-gray-400 hover:bg-gray-500 text-white text-2xl font-bold py-4 rounded-xl text-center" %>
    </div>
  <% end %>
</div>

<script>
  // Auto-calculate total
  function updateTotal() {
    var qty   = parseFloat(document.getElementById('qty_field').value) || 0;
    var price = parseFloat(document.getElementById('price_field').value) || 0;
    var total = qty * price;
    document.getElementById('total_display').textContent = '₹' + total.toLocaleString('en-IN', {maximumFractionDigits: 0});
  }

  document.getElementById('qty_field').addEventListener('input', updateTotal);
  document.getElementById('price_field').addEventListener('input', updateTotal);

  // Auto-fill price from product selection
  var productPrices = {
    <% @products.each do |name, price| %>
      "<%= name %>": <%= price.to_f %>,
    <% end %>
  };
  document.getElementById('product_select').addEventListener('change', function() {
    var price = productPrices[this.value];
    if (price) {
      document.getElementById('price_field').value = price;
      updateTotal();
    }
  });
</script>
