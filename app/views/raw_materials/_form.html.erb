<%= form_with model: material, local: true, class: "space-y-6" do |f| %>
  <% if material.errors.any? %>
    <div class="bg-red-100 border-l-4 border-red-600 p-4 rounded-lg">
      <p class="text-xl font-bold text-red-800">Please fix these errors:</p>
      <ul class="mt-2 list-disc list-inside">
        <% material.errors.full_messages.each do |msg| %>
          <li class="text-lg text-red-700"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :material_name, "Material Name", class: "block text-xl font-semibold text-gray-800 mb-2" %>
    <%= f.text_field :material_name, placeholder: "e.g., Phenol, Acid, Solvent",
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :unit_of_measurement, "Unit of Measurement", class: "block text-xl font-semibold text-gray-800 mb-2" %>
    <%= f.select :unit_of_measurement, ["liter", "kg", "bottle", "gram", "ton"],
        { prompt: "Select unit" },
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none bg-white" %>
  </div>

  <div>
    <%= f.label :current_stock_quantity, "Current Stock Quantity", class: "block text-xl font-semibold text-gray-800 mb-2" %>
    <%= f.number_field :current_stock_quantity, placeholder: "0", step: "0.01", min: 0,
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :reorder_level, "Minimum Stock Level (Reorder When Below This)", class: "block text-xl font-semibold text-gray-800 mb-2" %>
    <%= f.number_field :reorder_level, placeholder: "0", step: "0.01", min: 0,
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
    <p class="text-lg text-gray-500 mt-1">System will alert when stock falls below this number</p>
  </div>

  <div>
    <%= f.label :cost_per_unit, "Cost Per Unit (₹)", class: "block text-xl font-semibold text-gray-800 mb-2" %>
    <%= f.number_field :cost_per_unit, placeholder: "0.00", step: "0.01", min: 0,
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :supplier_id, "Supplier", class: "block text-xl font-semibold text-gray-800 mb-2" %>
    <%= f.select :supplier_id, @suppliers.map { |s| [s.supplier_name, s.id] },
        { prompt: "Select supplier (optional)" },
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none bg-white" %>
  </div>

  <div class="flex gap-4 pt-4">
    <%= f.submit material.new_record? ? "SAVE MATERIAL" : "UPDATE MATERIAL",
        class: "flex-1 bg-blue-600 hover:bg-blue-700 text-white text-2xl font-bold py-4 rounded-xl cursor-pointer" %>
    <%= link_to "CANCEL", raw_materials_path,
        class: "flex-1 bg-gray-400 hover:bg-gray-500 text-white text-2xl font-bold py-4 rounded-xl text-center" %>
  </div>
<% end %>
