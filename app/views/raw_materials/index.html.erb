<div class="flex items-center justify-between mb-6">
  <h1 class="text-3xl font-black text-gray-800">🧪 Raw Materials</h1>
  <div class="flex gap-3">
    <%= link_to "+ New Material", new_raw_material_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-3 rounded-lg text-lg" %>
    <%= link_to "📋 Suppliers", suppliers_path, class: "bg-gray-600 hover:bg-gray-700 text-white font-bold px-5 py-3 rounded-lg text-lg" %>
  </div>
</div>

<% if @low_count > 0 %>
  <div class="bg-red-100 border-l-4 border-red-600 text-red-800 p-4 rounded-lg mb-5 text-xl font-bold">
    ⚠️ <%= @low_count %> material(s) are running LOW — order now!
  </div>
<% end %>

<div class="bg-white rounded-2xl shadow overflow-hidden">
  <table class="w-full">
    <thead class="bg-gray-100">
      <tr>
        <th class="px-5 py-4 text-left text-lg font-bold text-gray-700">Material Name</th>
        <th class="px-5 py-4 text-left text-lg font-bold text-gray-700">Current Stock</th>
        <th class="px-5 py-4 text-left text-lg font-bold text-gray-700">Min. Level</th>
        <th class="px-5 py-4 text-left text-lg font-bold text-gray-700">Cost/Unit</th>
        <th class="px-5 py-4 text-left text-lg font-bold text-gray-700">Supplier</th>
        <th class="px-5 py-4 text-left text-lg font-bold text-gray-700">Status</th>
        <th class="px-5 py-4 text-left text-lg font-bold text-gray-700">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @materials.each_with_index do |m, i| %>
        <tr class="border-t <%= i.even? ? 'bg-white' : 'bg-gray-50' %> hover:bg-blue-50">
          <td class="px-5 py-4 text-lg font-semibold"><%= m.material_name %></td>
          <td class="px-5 py-4 text-lg <%= m.low_stock? ? 'text-red-700 font-bold' : 'text-gray-800' %>">
            <%= m.current_stock_quantity %> <%= m.unit_of_measurement %>
          </td>
          <td class="px-5 py-4 text-lg"><%= m.reorder_level %> <%= m.unit_of_measurement %></td>
          <td class="px-5 py-4 text-lg">₹<%= m.cost_per_unit %></td>
          <td class="px-5 py-4 text-lg"><%= m.supplier&.supplier_name || "—" %></td>
          <td class="px-5 py-4">
            <% if m.low_stock? %>
              <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full font-bold text-base">⚠️ LOW</span>
            <% else %>
              <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full font-bold text-base">✅ OK</span>
            <% end %>
          </td>
          <td class="px-5 py-4">
            <div class="flex gap-2 flex-wrap">
              <%= link_to "Add Stock", add_stock_raw_material_path(m),
                  class: "bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-2 rounded-lg text-base" %>
              <%= link_to "Edit", edit_raw_material_path(m),
                  class: "bg-blue-500 hover:bg-blue-600 text-white font-bold px-4 py-2 rounded-lg text-base" %>
              <%= button_to "Delete", raw_material_path(m), method: :delete,
                  data: { confirm: "Delete #{m.material_name}?" },
                  class: "bg-red-500 hover:bg-red-600 text-white font-bold px-4 py-2 rounded-lg text-base" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @materials.empty? %>
    <div class="p-10 text-center text-xl text-gray-500">No materials yet. Click "+ New Material" to add one.</div>
  <% end %>
</div>
