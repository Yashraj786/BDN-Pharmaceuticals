<div class="max-w-2xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-black text-gray-800">🧪 <%= @material.material_name %></h1>
    <div class="flex gap-3">
      <%= link_to "Edit", edit_raw_material_path(@material), class: "bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-3 rounded-lg text-lg" %>
      <%= link_to "← Back", raw_materials_path, class: "bg-gray-500 hover:bg-gray-600 text-white font-bold px-5 py-3 rounded-lg text-lg" %>
    </div>
  </div>

  <div class="bg-white rounded-2xl shadow p-6 space-y-4">
    <div class="grid grid-cols-2 gap-4">
      <div class="bg-gray-50 p-4 rounded-xl">
        <p class="text-base text-gray-500">Unit</p>
        <p class="text-2xl font-bold"><%= @material.unit_of_measurement %></p>
      </div>
      <div class="<%= @material.low_stock? ? 'bg-red-50' : 'bg-green-50' %> p-4 rounded-xl">
        <p class="text-base text-gray-500">Current Stock</p>
        <p class="text-2xl font-bold <%= @material.low_stock? ? 'text-red-700' : 'text-green-700' %>">
          <%= @material.current_stock_quantity %> <%= @material.unit_of_measurement %>
        </p>
      </div>
      <div class="bg-gray-50 p-4 rounded-xl">
        <p class="text-base text-gray-500">Reorder Level</p>
        <p class="text-2xl font-bold"><%= @material.reorder_level %> <%= @material.unit_of_measurement %></p>
      </div>
      <div class="bg-gray-50 p-4 rounded-xl">
        <p class="text-base text-gray-500">Cost Per Unit</p>
        <p class="text-2xl font-bold">₹<%= @material.cost_per_unit %></p>
      </div>
    </div>
    <% if @material.supplier %>
      <div class="bg-blue-50 p-4 rounded-xl">
        <p class="text-base text-gray-500">Supplier</p>
        <p class="text-2xl font-bold"><%= @material.supplier.supplier_name %></p>
        <p class="text-lg text-gray-600">📞 <%= @material.supplier.phone %></p>
      </div>
    <% end %>
  </div>

  <!-- ADD STOCK FORM -->
  <div class="bg-blue-50 border-2 border-blue-300 rounded-2xl p-6 mt-6">
    <h2 class="text-2xl font-bold text-blue-800 mb-4">➕ Add Stock</h2>
    <%= form_with url: add_stock_raw_material_path(@material), method: :post, local: true do |f| %>
      <div class="mb-4">
        <label class="block text-xl font-semibold text-gray-800 mb-2">Quantity to Add (<%= @material.unit_of_measurement %>)</label>
        <%= f.number_field :quantity_added, placeholder: "0", step: "0.01", min: 0.01,
            class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none",
            required: true %>
      </div>
      <div class="mb-6">
        <label class="block text-xl font-semibold text-gray-800 mb-2">New Cost Per Unit (₹) — Optional</label>
        <%= f.number_field :cost_per_unit, placeholder: "Leave blank to keep current",
            step: "0.01", min: 0,
            class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
      </div>
      <%= f.submit "ADD STOCK NOW",
          class: "w-full bg-green-600 hover:bg-green-700 text-white text-2xl font-bold py-4 rounded-xl cursor-pointer" %>
    <% end %>
  </div>
</div>
