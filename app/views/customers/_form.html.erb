<%= form_with model: customer, local: true, class: "space-y-5" do |f| %>
  <div><%= f.label :customer_name, "Customer / Company Name", class: "block text-xl font-semibold mb-2" %>
    <%= f.text_field :customer_name, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
  <div><%= f.label :phone, "Phone Number", class: "block text-xl font-semibold mb-2" %>
    <%= f.text_field :phone, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
  <div><%= f.label :address, "Address", class: "block text-xl font-semibold mb-2" %>
    <%= f.text_area :address, rows: 2, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
  <div><%= f.label :city, "City", class: "block text-xl font-semibold mb-2" %>
    <%= f.text_field :city, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
  <div><%= f.label :contact_person, "Contact Person", class: "block text-xl font-semibold mb-2" %>
    <%= f.text_field :contact_person, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
  <div><%= f.label :credit_limit, "Credit Limit (₹)", class: "block text-xl font-semibold mb-2" %>
    <%= f.number_field :credit_limit, step: "0.01", min: 0, class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %></div>
  <div class="flex gap-4 pt-4">
    <%= f.submit customer.new_record? ? "SAVE CUSTOMER" : "UPDATE CUSTOMER", class: "flex-1 bg-blue-600 hover:bg-blue-700 text-white text-2xl font-bold py-4 rounded-xl cursor-pointer" %>
    <%= link_to "CANCEL", customers_path, class: "flex-1 bg-gray-400 hover:bg-gray-500 text-white text-2xl font-bold py-4 rounded-xl text-center" %>
  </div>
<% end %>
