<%= form_with model: batch, local: true, class: "space-y-6" do |f| %>
  <% if batch.errors.any? %>
    <div class="bg-red-100 border-l-4 border-red-600 p-4 rounded-lg">
      <% batch.errors.full_messages.each do |msg| %>
        <p class="text-lg text-red-700">• <%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :batch_name, "Batch Name", class: "block text-xl font-semibold mb-2" %>
    <%= f.text_field :batch_name, placeholder: "e.g., Batch-001",
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :batch_date, "Production Date", class: "block text-xl font-semibold mb-2" %>
    <%= f.date_field :batch_date,
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :product_name, "Product Type", class: "block text-xl font-semibold mb-2" %>
    <%= f.select :product_name, ProductionBatch::PRODUCTS,
        { prompt: "Select product" },
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none bg-white" %>
  </div>

  <div>
    <%= f.label :quantity_produced_liters, "Quantity to Produce (Liters)", class: "block text-xl font-semibold mb-2" %>
    <%= f.number_field :quantity_produced_liters, placeholder: "0", step: "0.01", min: 1,
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :production_cost, "Total Production Cost (₹)", class: "block text-xl font-semibold mb-2" %>
    <%= f.number_field :production_cost, placeholder: "0.00", step: "0.01", min: 0,
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
    <p class="text-lg text-gray-500 mt-1">Include all costs: materials, labor, packaging</p>
  </div>

  <div>
    <%= f.label :expected_sale_price, "Expected Sale Price Per Liter (₹)", class: "block text-xl font-semibold mb-2" %>
    <%= f.number_field :expected_sale_price, placeholder: "0.00", step: "0.01", min: 0,
        class: "w-full text-xl p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none" %>
  </div>

  <!-- AUTO PROFIT PREVIEW -->
  <div class="bg-blue-50 border-2 border-blue-300 rounded-xl p-4 text-lg text-blue-800 font-semibold">
    💡 Profit = (Sale Price × Quantity) − Total Cost — Calculated automatically!
  </div>

  <div class="flex gap-4 pt-4">
    <%= f.submit batch.new_record? ? "START BATCH" : "UPDATE BATCH",
        class: "flex-1 bg-blue-600 hover:bg-blue-700 text-white text-2xl font-bold py-4 rounded-xl cursor-pointer" %>
    <%= link_to "CANCEL", production_batches_path,
        class: "flex-1 bg-gray-400 hover:bg-gray-500 text-white text-2xl font-bold py-4 rounded-xl text-center" %>
  </div>
<% end %>
